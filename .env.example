# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase → Connect → Transaction pooler (port 6543). Serves requests.
# Percent-encode reserved characters in the password (@ becomes %40).
# Do NOT append ?sslmode=... — pg's connection-string parser would override
# the ssl options set in payload.config.ts.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Connect → Direct connection (port 5432), or the Session pooler if
# your host has no IPv6 — AWS Amplify build containers do not, so use the
# session pooler there. Used for dev-mode schema push and `pnpm migrate`.
DATABASE_URI_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Long random string used to sign auth tokens. Generate with:
#   openssl rand -hex 32
# Use a different value in production than the one you develop with.
PAYLOAD_SECRET=

# Supabase signs Postgres certs with a private root CA that Node does not
# trust. Download it from Settings → Database → SSL Configuration. One of the
# two variables below is required in production — see certs/README.md.
#
# Path form: relative to the project root. Good for local development.
DATABASE_CA_CERT=certs/supabase-ca.crt
#
# Inline form: the PEM itself, raw or base64. Takes precedence over the path,
# and is what serverless hosts should use — nothing has to resolve a file.
# DATABASE_CA_CERT_VALUE=

# Local-dev escape hatch: encrypt without verifying the server. Use only when
# neither certificate variable is set, and never in production.
# DATABASE_SSL_INSECURE=true

# Public origin. Used for Open Graph and canonical URLs, and for Payload's
# serverURL / CORS / CSRF allow-lists. Baked in at build time.
NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# Object storage for media uploads. Leave S3_BUCKET unset locally to keep
# writing to public/media; setting it switches Payload to the S3 adapter.
# Supabase Storage is S3-compatible — Settings → Storage for endpoint and keys.
# Required in production: public/media is neither served nor persisted there.
# S3_BUCKET=media
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Supabase needs path-style addressing (the default here). Set to false for
# real AWS S3.
# S3_FORCE_PATH_STYLE=true

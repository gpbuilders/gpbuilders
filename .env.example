# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase → Connect → Transaction pooler (port 6543). Serves requests.
# Percent-encode reserved characters in the password (@ becomes %40).
# Do NOT append ?sslmode=... — pg's connection-string parser would override
# the ssl options set in payload.config.ts.
DATABASE_URI=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Connect → Direct connection (port 5432), or the Session pooler if
# your host has no IPv6. Used for dev-mode schema push and `pnpm migrate`.
DATABASE_URI_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Long random string used to sign auth tokens. Generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Supabase signs Postgres certs with a private root CA that Node does not
# trust. Download it from Settings → Database → SSL Configuration and point
# this at it. Required in production.
DATABASE_CA_CERT=certs/supabase-ca.crt

# Local-dev escape hatch: encrypt without verifying the server. Use only when
# DATABASE_CA_CERT is unset, and never in production.
# DATABASE_SSL_INSECURE=true

# Public origin, used for Open Graph / canonical URLs.
NEXT_PUBLIC_SERVER_URL=https://your-domain.com
